# Biến build của app (docs/dev/chay-va-test.md). Chép thành .env.local rồi điền.
# Supabase chạy trên máy: lấy API_URL và ANON_KEY bằng `npx -y supabase@2.122.1 status -o env`.
# Khóa anon là công khai. Không bao giờ đặt khóa service_role ở đây.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# YC1.7: địa chỉ chat Zalo của Home247 (ví dụ https://zalo.me/<mã OA>). Để trống thì dùng địa chỉ chung.
VITE_ZALO_HOME247=
