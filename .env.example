# Chép thành .env.local rồi điền. File .env.local không đưa lên repo. Trên máy dev luôn dùng project STAGING, không dùng production.
# Hai giá trị dưới đây là khóa CÔNG KHAI (publishable/anon), để lộ được. Khóa service_role thì KHÔNG BAO GIỜ đặt ở đây.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key>
